{
  "name": "chart-ooxml-adapter",
  "version": "0.1.0",
  "description": "Convert JavaScript chart library configurations into a DemoMacro-compatible Office Open JSON chart object (Chart Model → Office Open JSON). Does not create PPTX/XLSX/DOCX packages.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schemas/office-open-chart.schema.json"
  },
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "ooxml",
    "office-open",
    "chart",
    "demomacro",
    "pptx",
    "xlsx",
    "docx",
    "echarts",
    "highcharts",
    "chartjs",
    "amcharts"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "ajv": "^8.17.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
